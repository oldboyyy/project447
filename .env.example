# Copy to .env, edit locally, then load with: set -a; . ./.env; set +a
# The application does not automatically read .env files.

# UI label; this is not an authenticated account.
DISPLAY_NAME=Instructor
# Local Flask server port (binds to 127.0.0.1).
PORT=8000
# Paths are relative to the project root, or may be absolute.
MODEL_PATH=models/retrained.pkl
DATA_DIR=data/raw
ROSTER_PATH=data/metadata/students_dataset.csv
# Disable photo samples unless you intentionally need them locally.
ENABLE_SAMPLES=0
# Face distance limit and minimum gap to the next distinct student.
FACE_MATCH_THRESHOLD=0.45
FACE_MATCH_MARGIN=0.05
# Gunicorn configuration for scripts/serve.sh.
BIND=127.0.0.1:8000
WEB_CONCURRENCY=2
